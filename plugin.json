{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "unreal-engine-skills-for-codex",
	"version": "0.2.0",
	"description": "Unreal Editor MCP and ToolsetRegistry",
	"author": {
		"name": "coquid",
		"url": "https://github.com/coquid"
	},
	"repository": "https://github.com/coquid/unreal-engine-skills-for-codex-plugin",
	"license": "MIT",
	"keywords": [
		"unreal-engine",
		"codex",
		"mcp",
		"toolsets",
		"skills"
	],
	"extensions": {
		"com.openai": {
			"requires_local_executor": true,
			"interface": {
				"displayName": "Unreal Engine MCP Skills",
				"shortDescription": "Unreal Editor MCP and ToolsetRegistry",
				"longDescription": "Connect to Unreal Editor through its MCP server, extend registered toolsets, and author in-editor Agent Skills.",
				"developerName": "coquid",
				"category": "Developer Tools",
				"capabilities": [
					"Read",
					"Write"
				],
				"defaultPrompt": [
					"Inspect the current Unreal Editor project through its MCP connection."
				]
			}
		}
	}
}
